{
  "name": "ServiceExtension",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u0623\u0635\u0644\u064a"
    },
    "booking_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u0623\u0635\u0644\u064a"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "provider_email": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "\u0645\u0627 \u064a\u0631\u064a\u062f\u0647 \u0627\u0644\u0639\u0645\u064a\u0644 \u0625\u0636\u0627\u0641\u0629"
    },
    "documents_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "amount": {
      "type": "number",
      "default": 15,
      "description": "\u0645\u0628\u0644\u063a \u0627\u0644\u062a\u0645\u062f\u064a\u062f (15\u20ac)"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "authorized",
        "paid",
        "failed"
      ],
      "default": "unpaid"
    },
    "payment_intent_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    }
  },
  "required": [
    "booking_id",
    "customer_email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "customer_email": "{{user.email}}"
        },
        {
          "provider_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "customer_email": "{{user.email}}"
        },
        {
          "provider_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
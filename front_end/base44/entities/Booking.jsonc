{
  "name": "Booking",
  "type": "object",
  "properties": {
    "booking_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062d\u062c\u0632"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_phone": {
      "type": "string",
      "description": "\u0647\u0627\u062a\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "service_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "service_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "category": {
      "type": "string",
      "enum": [
        "education",
        "bureaucracy",
        "cleaning",
        "transport",
        "handwerk",
        "design",
        "legal",
        "garden",
        "office",
        "forms",
        "admin",
        "coordination",
        "mercosur",
        "tutoring",
        "print"
      ]
    },
    "provider_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0645\u0632\u0648\u062f \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "provider_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0645\u0632\u0648\u062f \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0627\u0644\u062a\u0627\u0631\u064a\u062e"
    },
    "time": {
      "type": "string",
      "description": "\u0627\u0644\u0648\u0642\u062a"
    },
    "duration_hours": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u062f\u0629 \u0628\u0627\u0644\u0633\u0627\u0639\u0627\u062a"
    },
    "address": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0637\u0644\u0628"
    },
    "documents_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0645\u0631\u0641\u0642\u0629 \u0645\u0646 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "provider_documents_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u062a\u064a \u0631\u0641\u0639\u0647\u0627 \u0645\u0632\u0648\u062f \u0627\u0644\u062e\u062f\u0645\u0629 \u0628\u0639\u062f \u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0639\u0645\u0644"
    },
    "required_documents_hint": {
      "type": "string",
      "description": "\u062a\u0644\u0645\u064a\u062d \u0644\u0644\u0639\u0645\u064a\u0644 \u062d\u0648\u0644 \u0627\u0644\u0623\u0648\u0631\u0627\u0642 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "price": {
      "type": "number",
      "description": "\u0627\u0644\u0633\u0639\u0631"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "authorized",
        "paid",
        "refunded",
        "failed"
      ],
      "default": "unpaid"
    },
    "payment_intent_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062f\u0641\u0639 \u0641\u064a Stripe"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "cash"
      ],
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "rating": {
      "type": "number",
      "description": "\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "review": {
      "type": "string",
      "description": "\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "confirmed_by_provider_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0632\u0648\u062f \u0627\u0644\u0630\u064a \u0623\u0643\u062f \u0627\u0644\u0637\u0644\u0628"
    },
    "confirmed_by_provider_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0632\u0648\u062f \u0627\u0644\u0630\u064a \u0623\u0643\u062f \u0627\u0644\u0637\u0644\u0628"
    },
    "confirmed_by_provider_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0632\u0648\u062f \u0627\u0644\u0630\u064a \u0623\u0643\u062f \u0627\u0644\u0637\u0644\u0628"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0627\u0644\u062a\u0623\u0643\u064a\u062f"
    },
    "invoice_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 PDF/HTML \u0627\u0644\u0645\u0648\u0644\u062f\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b"
    }
  },
  "required": [
    "customer_name",
    "customer_email",
    "customer_phone",
    "category"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "customer_email": {
            "$regex": "^{{user.email}}$",
            "$options": "i"
          }
        },
        {
          "confirmed_by_provider_email": {
            "$regex": "^{{user.email}}$",
            "$options": "i"
          }
        },
        {
          "status": "pending"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "customer_email": {
            "$regex": "^{{user.email}}$",
            "$options": "i"
          }
        },
        {
          "confirmed_by_provider_email": {
            "$regex": "^{{user.email}}$",
            "$options": "i"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}